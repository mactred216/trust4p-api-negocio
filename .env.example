MONGO_URI=
SERVICIO_AGENTE_URL=
API_KEY_SERVICIOS=
# Plazo máximo de espera al servicio del agente, en segundos. Debe cubrir el
# arranque en frío de su instancia además de la generación (por defecto 300).
AGENTE_TIEMPO_ESPERA_SEGUNDOS=300

# Gmail SMTP: usar una contraseña de aplicación (https://myaccount.google.com/apppasswords),
# no la contraseña normal de la cuenta. Requiere verificación en dos pasos activada.
SMTP_HOST=smtp.gmail.com
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_REMITENTE=

# Frontend (https://github.com/sroa544/trust4p-frontend): los enlaces de los correos
# (invitación y restablecimiento) apuntan aquí, y CORS solo admite estos orígenes
# (separados por coma). En producción: el dominio HTTPS del frontend.
URL_FRONTEND=http://localhost:5173
CORS_ORIGENES=http://localhost:5173,http://localhost:3000
